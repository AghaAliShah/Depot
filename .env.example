# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the two values from your Supabase project.
#   Dashboard -> Project Settings -> API
# The .env file is git-ignored, so your keys stay on your machine.
# ---------------------------------------------------------------------------

# "Project URL", looks like https://abcdefghijklm.supabase.co
SUPABASE_URL=

# The "anon" / "publishable" key. Safe for client apps, because Row Level
# Security decides what it is actually allowed to touch.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Optional settings — sensible defaults are used if you leave these blank.
# ---------------------------------------------------------------------------

# Storage bucket created by sql/schema.sql
SUPABASE_BUCKET=documents

# Name of the deployed Edge Function
EDGE_FUNCTION_NAME=file-guard

# Whose files are these? Used as the "owner" column and the folder name.
APP_USER=demo_user

# Where "download" puts files
DOWNLOAD_DIR=downloads

# NEVER put the service_role key in a client app. The Edge Function gets it
# automatically from Supabase. It is listed here only so you know NOT to add it.
# SUPABASE_SERVICE_ROLE_KEY=do-not-put-this-here
